# Environment Variables para Docker Compose no Easypanel

# === SENHAS (ALTERE ESTAS!) ===
POSTGRES_PASSWORD=sua_senha_postgresql_muito_forte_123
N8N_AUTH_USER=admin
N8N_AUTH_PASSWORD=sua_senha_admin_muito_forte_123
N8N_ENCRYPTION_KEY=uma-chave-secreta-de-32-caracteres-aqui

# === CONFIGURAÇÕES DE DOMÍNIO ===
# Substitua pelo seu domínio do Easypanel
WEBHOOK_URL=https://n8n.seudominio.easypanel.host

# === CONFIGURAÇÕES OPCIONAIS ===
# Timezone
GENERIC_TIMEZONE=America/Sao_Paulo

# Configurações de execução
EXECUTIONS_TIMEOUT=3600
EXECUTIONS_DATA_MAX_AGE=336

# === PARA TESTES LOCAIS ===
# Descomente as linhas abaixo para testar localmente
# WEBHOOK_URL=http://localhost:5678
# N8N_SECURE_COOKIE=false